# .gitignore — paranoid baseline for legal records.
# RULE: secrets never appear in git; signed originals live in the
# document-management custody location — git stores metadata + pointers.

# ── Signed-original caches & e-signature exports (NEVER in git) ───────────
# Local mirrors of signed PDFs and e-signature envelope exports are
# transient operator artifacts; custody lives in the DMS.
**/.signed-cache/
**/signed-cache/
*.esign-envelope
**/envelope-exports/
**/esign-exports/

# ── Secrets & key material ────────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.jks
*.gpg
*.agekey
id_rsa*
id_ed25519*

# ── Environment & credential files ────────────────────────────────────────
.env
.env.*
!.envrc.example
.envrc

# ── Working drafts outside the lifecycle (temp exports from editors) ──────
*.tmp
*~

# ── Editors / OS ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store

# ── Python virtual environments (tooling harness only — no runtime code) ──
.venv/
venv/
